diff --git a/sixel-enc.c b/sixel-enc.c
new file mode 100644
--- a/sixel-enc.c
+++ b/sixel-enc.c
@@ -0,0 +1,311 @@
+/* $OpenBSD$ */
+
+/*
+ * Copyright (c) 2024 Thomas Adam <thomas@xteddy.org>
+ *
+ * Permission to use, copy, modify, and distribute this software for any
+ * purpose with or without fee is hereby granted, provided that the above
+ * copyright notice and this permission notice appear in all copies.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES
+ * WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
+ * MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR
+ * ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+ * WHATSOEVER RESULTING FROM LOSS OF MIND, USE, DATA OR PROFITS, WHETHER
+ * IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING
+ * OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+#include <sys/types.h>
+
+#include <limits.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "tmux.h"
+
+/*
+ * Encode an RGBA pixel buffer to a DCS-wrapped sixel byte stream.
+ *   rgba    row-major, 4 bytes per pixel: R, G, B, A
+ *   w, h    dimensions in pixels
+ *   *lenp   receives the byte count of the returned buffer
+ *
+ * Pixels with A < 128 are transparent (DCS P2=1).  Up to 255 unique opaque
+ * colors are assigned to sixel registers 1..N.  If more than 255 unique
+ * colors exist, extras are mapped to the nearest register (RGB L2 distance).
+ * Returns a malloc'd char buffer that the caller must free.
+ *
+ * sixel_from_rgba() is a convenience wrapper that also calls sixel_parse()
+ * and returns a struct sixel_image *.
+ */
+
+#define MAX_REG    255
+#define PHASH_SZ   4096u
+#define PHASH_MK   (PHASH_SZ - 1u)
+
+struct phash_slot {
+	u_int	key;	/* 0x00RRGGBB; meaningful only when reg != 0 */
+	u_char	reg;	/* 1-based sixel register; 0 = empty slot */
+};
+
+static u_char
+phash_get(const struct phash_slot *ht, u_int key)
+{
+	u_int h;
+
+	h = (key ^ (key >> 12)) & PHASH_MK;
+	while (ht[h].reg != 0) {
+		if (ht[h].key == key)
+			return (ht[h].reg);
+		h = (h + 1) & PHASH_MK;
+	}
+	return (0);
+}
+
+static void
+phash_put(struct phash_slot *ht, u_int key, u_char reg)
+{
+	u_int h;
+
+	h = (key ^ (key >> 12)) & PHASH_MK;
+	while (ht[h].reg != 0)
+		h = (h + 1) & PHASH_MK;
+	ht[h].key = key;
+	ht[h].reg = reg;
+}
+
+static u_char
+nearest_reg(const u_char *pr, const u_char *pg, const u_char *pb,
+    int n, u_char r, u_char g, u_char b)
+{
+	int	i, best, bdist, d, dr, dg, db;
+
+	best  = 0;
+	bdist = INT_MAX;
+	for (i = 0; i < n; i++) {
+		dr = (int)pr[i] - (int)r;
+		dg = (int)pg[i] - (int)g;
+		db = (int)pb[i] - (int)b;
+		d  = dr * dr + dg * dg + db * db;
+		if (d < bdist) {
+			bdist = d;
+			best  = i;
+		}
+	}
+	return ((u_char)(best + 1));
+}
+
+/* Growing output buffer. */
+struct sbuf {
+	char	*data;
+	size_t	 len;
+	size_t	 cap;
+};
+
+static void
+sbuf_grow(struct sbuf *sb, size_t n)
+{
+	while (sb->len + n > sb->cap) {
+		sb->cap *= 2;
+		sb->data = xrealloc(sb->data, sb->cap);
+	}
+}
+
+static void
+sbuf_bytes(struct sbuf *sb, const void *p, size_t n)
+{
+	sbuf_grow(sb, n);
+	memcpy(sb->data + sb->len, p, n);
+	sb->len += n;
+}
+
+static void
+sbuf_str(struct sbuf *sb, const char *s)
+{
+	sbuf_bytes(sb, s, strlen(s));
+}
+
+static void
+sbuf_byte(struct sbuf *sb, u_char c)
+{
+	sbuf_grow(sb, 1);
+	sb->data[sb->len++] = (char)c;
+}
+
+static void
+sbuf_fmt(struct sbuf *sb, const char *fmt, ...)
+{
+	char	 tmp[64];
+	va_list	 ap;
+
+	va_start(ap, fmt);
+	vsnprintf(tmp, sizeof tmp, fmt, ap);
+	va_end(ap);
+	sbuf_str(sb, tmp);
+}
+
+char *
+sixel_encode_rgba(const u_char *rgba, u_int w, u_int h, size_t *lenp)
+{
+	struct phash_slot	*ht;
+	u_char			 palr[MAX_REG], palg[MAX_REG], palb[MAX_REG];
+	u_char			*regmap;
+	int			 ncolors;
+	u_int			 x, y, band, bi, by, rows, ci, cnt;
+	struct sbuf		 sb;
+	u_char			*row;
+	const u_char		*p;
+	u_char			 r, g, b, a, reg, ch, bits;
+	u_int			 key;
+	int			 i, r100, g100, b100, first, has_any;
+	char			 tmp[32];
+	u_int			 j;
+
+	ht      = xcalloc(PHASH_SZ, sizeof *ht);
+	regmap  = xmalloc((size_t)w * h);
+	ncolors = 0;
+
+	/* Pass 1: assign palette registers to unique opaque colors. */
+	for (y = 0; y < h; y++) {
+		for (x = 0; x < w; x++) {
+			p = rgba + ((size_t)y * w + x) * 4;
+			a = p[3];
+			if (a < 128) {
+				regmap[(size_t)y * w + x] = 0;
+				continue;
+			}
+			r   = p[0]; g = p[1]; b = p[2];
+			key = ((u_int)r << 16) | ((u_int)g << 8) | b;
+			reg = phash_get(ht, key);
+			if (reg == 0) {
+				if (ncolors < MAX_REG) {
+					ncolors++;
+					reg              = (u_char)ncolors;
+					palr[ncolors-1]  = r;
+					palg[ncolors-1]  = g;
+					palb[ncolors-1]  = b;
+					phash_put(ht, key, reg);
+				} else
+					reg = nearest_reg(palr, palg, palb,
+					    ncolors, r, g, b);
+			}
+			regmap[(size_t)y * w + x] = reg;
+		}
+	}
+	free(ht);
+
+	/* Pass 2: build sixel stream. */
+	sb.cap  = 131072;
+	sb.len  = 0;
+	sb.data = xmalloc(sb.cap);
+
+	/* DCS header: P2=1 means unset pixels retain terminal background. */
+	sbuf_fmt(&sb, "\033P0;1;0q\"1;1;%u;%u", w, h);
+
+	/* Color register definitions: #N;2;r;g;b (values 0..100). */
+	for (i = 0; i < ncolors; i++) {
+		r100 = ((int)palr[i] * 100 + 127) / 255;
+		g100 = ((int)palg[i] * 100 + 127) / 255;
+		b100 = ((int)palb[i] * 100 + 127) / 255;
+		sbuf_fmt(&sb, "#%d;2;%d;%d;%d", i + 1, r100, g100, b100);
+	}
+
+	row = xmalloc(w);
+
+	/* One sixel band covers 6 pixel rows. */
+	for (band = 0; band * 6 < h; band++) {
+		by   = band * 6;
+		rows = h - by;
+		if (rows > 6)
+			rows = 6;
+		first = 1;
+
+		for (i = 0; i < ncolors; i++) {
+			reg     = (u_char)(i + 1);
+			has_any = 0;
+
+			for (x = 0; x < w; x++) {
+				bits = 0;
+				for (bi = 0; bi < rows; bi++) {
+					if (regmap[(size_t)(by + bi) * w + x] == reg)
+						bits |= (u_char)(1u << bi);
+				}
+				row[x] = (u_char)(63 + bits);
+				if (bits)
+					has_any = 1;
+			}
+			if (!has_any)
+				continue;
+
+			if (!first)
+				sbuf_byte(&sb, '$');	/* CR: return to band start */
+			first = 0;
+
+			sbuf_fmt(&sb, "#%d", reg);
+
+			/* RLE: runs of 4+ characters become !N<char>. */
+			ci = 0;
+			while (ci < w) {
+				ch  = row[ci];
+				cnt = 1;
+				while (ci + cnt < w && row[ci + cnt] == ch)
+					cnt++;
+				if (cnt >= 4) {
+					snprintf(tmp, sizeof tmp, "!%u%c", cnt, (int)ch);
+					sbuf_str(&sb, tmp);
+				} else {
+					for (j = 0; j < cnt; j++)
+						sbuf_byte(&sb, ch);
+				}
+				ci += cnt;
+			}
+		}
+		if (by + 6 < h)
+			sbuf_byte(&sb, '-');	/* LF: advance to next band */
+	}
+
+	/* String terminator: ESC \ */
+	sbuf_byte(&sb, 0x1b);
+	sbuf_byte(&sb, '\\');
+
+	free(row);
+	free(regmap);
+	*lenp = sb.len;
+	return (sb.data);
+}
+
+struct sixel_image *
+sixel_from_rgba(const u_char *rgba, u_int w, u_int h, u_int xpixel, u_int ypixel)
+{
+	char		   *buf, *start;
+	size_t		    len, slen;
+	struct sixel_image *si;
+
+	buf   = sixel_encode_rgba(rgba, w, h, &len);
+	start = buf;
+	slen  = len;
+
+	/*
+	 * sixel_parse expects data starting at 'q' (the DCS final byte).
+	 * Strip the ESC P ... prefix if present.
+	 */
+	if (len >= 2 && (u_char)buf[0] == 0x1b && buf[1] == 'P') {
+		char *ep = buf + 2, *ee = buf + len;
+		while (ep < ee && *ep != 'q')
+			ep++;
+		if (ep < ee)
+			start = ep;
+		slen = (size_t)(buf + len - start);
+	}
+	/* Strip trailing ESC \ */
+	if (slen >= 2 &&
+	    (u_char)start[slen - 2] == 0x1b &&
+	    (u_char)start[slen - 1] == '\\')
+		slen -= 2;
+
+	si = sixel_parse(start, slen, 1, xpixel, ypixel);
+	free(buf);
+	return (si);
+}
