+ * IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING
+ * OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+#include <sys/types.h>
+#include <sys/stat.h>
+
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+#include "tmux.h"
+
+/*
+ * Set or clear a sixel image overlay on the client terminal.
+ * Usage: overlay-image set X Y FILE
+ *        overlay-image clear
+ */
+
+static enum cmd_retval	cmd_overlay_image_exec(struct cmd *, struct cmdq_item *);
+
+const struct cmd_entry cmd_overlay_image_entry = {
+	.name = "overlay-image",
+	.alias = "overlayimage",
+
+	.args = { "t:W:H:", 1, 4, NULL },
+	.usage = "[-t target-client] [-W cols] [-H rows] set X Y FILE | animate X Y FILE | clear",
+
+	.flags = CMD_AFTERHOOK|CMD_CLIENT_TFLAG,
+	.exec = cmd_overlay_image_exec
+};
+
+static enum cmd_retval
+cmd_overlay_image_exec(struct cmd *self, struct cmdq_item *item)
+{
+	struct args		*args = cmd_get_args(self);
+	struct client		*tc = cmdq_get_target_client(item);
+	const char		*subcmd, *xpath, *errstr;
+	const char		*wopt, *hopt;
+	char			*buf, *start, *end, *p;
+	FILE			*f;
+	struct stat		 st;
+	size_t			 len, slen;
+	struct sixel_image	*si;
+	long long		 x, y, wcols, hrows;
+	u_int			 cell_px, cell_py, pw, ph;
+
+	subcmd = args_string(args, 0);
+	if (subcmd == NULL) {
+		cmdq_error(item, "missing subcommand");
+		return (CMD_RETURN_ERROR);
+	}
+
+	if (strcmp(subcmd, "clear") == 0) {
+		image_overlay_clear(tc);
+		server_redraw_client(tc);
+		return (CMD_RETURN_NORMAL);
+	}
+
+	if (strcmp(subcmd, "animate") == 0) {
+#ifdef HAVE_GIFLIB
+		struct sixel_image	**aframes;
+		u_int			*adurations;
+		u_int			 anframes;
+		const char		*gerr;
+
+		if (args_count(args) < 4) {
+			cmdq_error(item, "usage: overlay-image animate X Y FILE");
+			return (CMD_RETURN_ERROR);
+		}
+
+		x = strtonum(args_string(args, 1), 0, UINT_MAX, &errstr);
+		if (errstr != NULL) {
+			cmdq_error(item, "X coordinate %s", errstr);
+			return (CMD_RETURN_ERROR);
+		}
+
+		y = strtonum(args_string(args, 2), 0, UINT_MAX, &errstr);
+		if (errstr != NULL) {
+			cmdq_error(item, "Y coordinate %s", errstr);
+			return (CMD_RETURN_ERROR);
+		}
+
+		xpath = args_string(args, 3);
+
+		wopt = args_get(args, 'W');
+		hopt = args_get(args, 'H');
+		pw = 0;
+		ph = 0;
+		if (wopt != NULL || hopt != NULL) {
+			cell_px = (tc->tty.xpixel > 0) ? tc->tty.xpixel : 8;
+			cell_py = (tc->tty.ypixel > 0) ? tc->tty.ypixel : 16;
+			wcols = (wopt != NULL)
+			    ? strtonum(wopt, 1, 10000, &errstr) : 0;
+			if (errstr != NULL) {
+				cmdq_error(item, "-W %s", errstr);
+				return (CMD_RETURN_ERROR);
+			}
+			hrows = (hopt != NULL)
+			    ? strtonum(hopt, 1, 10000, &errstr) : 0;
+			if (errstr != NULL) {
+				cmdq_error(item, "-H %s", errstr);
+				return (CMD_RETURN_ERROR);
+			}
+			pw = (wopt != NULL) ? (u_int)wcols * cell_px : 0;
+			ph = (hopt != NULL) ? (u_int)hrows * cell_py : 0;
+		}
+
+		anframes = image_load_gif(xpath, pw, ph,
+		    tc->tty.xpixel, tc->tty.ypixel,
+		    &aframes, &adurations, &gerr);
+		if (anframes == 0) {
+			cmdq_error(item, "%s: %s", xpath,
+			    gerr != NULL ? gerr : "failed to load");
+			return (CMD_RETURN_ERROR);
+		}
+
+		image_overlay_animate(tc, aframes, adurations, anframes,
+		    (u_int)x, (u_int)y);
+		return (CMD_RETURN_NORMAL);
+#else
+		cmdq_error(item, "overlay-image animate requires giflib "
+		    "(rebuild tmux with giflib installed)");
+		return (CMD_RETURN_ERROR);
+#endif
+	}
+
+	if (strcmp(subcmd, "set") != 0) {
+		cmdq_error(item, "unknown subcommand: %s", subcmd);
+		return (CMD_RETURN_ERROR);
+	}
+
+	if (args_count(args) < 4) {
+		cmdq_error(item, "usage: overlay-image set X Y FILE");
+		return (CMD_RETURN_ERROR);
+	}
+
+	x = strtonum(args_string(args, 1), 0, UINT_MAX, &errstr);
+	if (errstr != NULL) {
+		cmdq_error(item, "X coordinate %s", errstr);
+		return (CMD_RETURN_ERROR);
+	}
+
+	y = strtonum(args_string(args, 2), 0, UINT_MAX, &errstr);
+	if (errstr != NULL) {
+		cmdq_error(item, "Y coordinate %s", errstr);
+		return (CMD_RETURN_ERROR);
+	}
+
+	xpath = args_string(args, 3);
+
+#ifdef HAVE_LIBPNG
+	/* PNG: load natively with libpng and return a sixel_image directly. */
+	{
+		const char	*ext = strrchr(xpath, '.');
+		if (ext != NULL && strcasecmp(ext, ".png") == 0) {
+			const char	*pngerr;
+
+			wopt = args_get(args, 'W');
+			hopt = args_get(args, 'H');
+			pw = 0;
+			ph = 0;
+			if (wopt != NULL || hopt != NULL) {
+				cell_px = (tc->tty.xpixel > 0) ? tc->tty.xpixel : 8;
+				cell_py = (tc->tty.ypixel > 0) ? tc->tty.ypixel : 16;
+				wcols = (wopt != NULL)
+				    ? strtonum(wopt, 1, 10000, &errstr) : 0;
+				if (errstr != NULL) {
+					cmdq_error(item, "-W %s", errstr);
+					return (CMD_RETURN_ERROR);
+				}
+				hrows = (hopt != NULL)
+				    ? strtonum(hopt, 1, 10000, &errstr) : 0;
+				if (errstr != NULL) {
+					cmdq_error(item, "-H %s", errstr);
+					return (CMD_RETURN_ERROR);
+				}
+				pw = (wopt != NULL) ? (u_int)wcols * cell_px : 0;
+				ph = (hopt != NULL) ? (u_int)hrows * cell_py : 0;
+			}
+			si = image_load_png(xpath, pw, ph,
+			    tc->tty.xpixel > 0 ? tc->tty.xpixel : 8,
+			    tc->tty.ypixel > 0 ? tc->tty.ypixel : 16,
+			    &pngerr);
+			if (si == NULL) {
+				cmdq_error(item, "%s: %s", xpath,
+				    pngerr != NULL ? pngerr : "failed to load PNG");
+				return (CMD_RETURN_ERROR);
+			}
+			image_overlay_set(tc, si, (u_int)x, (u_int)y);
+			return (CMD_RETURN_NORMAL);
+		}
+	}
+#else
+	{
+		const char	*ext = strrchr(xpath, '.');
+		if (ext != NULL && strcasecmp(ext, ".png") == 0) {
+			cmdq_error(item, "overlay-image set with .png requires "
+			    "libpng (rebuild tmux with libpng installed)");
+			return (CMD_RETURN_ERROR);
+		}
+	}
+#endif
+
+	/* Sixel file: read raw bytes then parse. */
+	if (stat(xpath, &st) != 0) {
+		cmdq_error(item, "%s: %s", xpath, strerror(errno));
+		return (CMD_RETURN_ERROR);
+	}
+	len = (size_t)st.st_size;
+	if (len == 0) {
+		cmdq_error(item, "%s: empty file", xpath);
+		return (CMD_RETURN_ERROR);
+	}
+
+	f = fopen(xpath, "rb");
+	if (f == NULL) {
+		cmdq_error(item, "%s: %s", xpath, strerror(errno));
+		return (CMD_RETURN_ERROR);
+	}
+
+	buf = xmalloc(len);
+	if (fread(buf, 1, len, f) != len) {
+		cmdq_error(item, "%s: read error", xpath);
+		free(buf);
+		fclose(f);
+		return (CMD_RETURN_ERROR);
+	}
+	fclose(f);
+
+	/*
+	 * sixel_parse expects the buffer to start with 'q' (the DCS final
+	 * byte).  Strip the leading ESC P ... prefix if present, extract the
+	 * P2 parameter (transparency mode), and strip the trailing ESC \.
+	 *
+	 * DCS format: ESC P <P1>;<P2>;<P3> q ...
+	 * P2=0 or P2=1: background filled; P2=2: background transparent.
+	 */
+	{
+		u_int	 file_p2 = 0;
+
+		start = buf;
+		end = buf + len;
+		if (len >= 2 && (unsigned char)buf[0] == 0x1b && buf[1] == 'P') {
+			/* Parse P1;P2;P3 params between ESC P and 'q'. */
+			p = buf + 2;
+			{
+				int	 field = 0;
+				long	 val = 0;
+				while (p < end && *p != 'q') {
+					if (*p >= '0' && *p <= '9') {
+						val = val * 10 + (*p - '0');
+					} else if (*p == ';') {
+						if (field == 1)
+							file_p2 = (u_int)val;
+						field++;
+						val = 0;
+					}
+					p++;
+				}
+				if (field == 1)
+					file_p2 = (u_int)val;
+			}
+			if (p < end)
+				start = p;   /* points at 'q' */
+		}
+		/* Strip trailing ESC \ (0x1b 0x5c) or ST if present. */
+		slen = (size_t)(end - start);
+		if (slen >= 2 &&
+		    (unsigned char)start[slen - 2] == 0x1b &&
+		    (unsigned char)start[slen - 1] == 0x5c)
+			slen -= 2;
+
+		si = sixel_parse(start, slen, file_p2,
+		    tc->tty.xpixel > 0 ? tc->tty.xpixel : 8,
+		    tc->tty.ypixel > 0 ? tc->tty.ypixel : 16);
+	}
+	free(buf);
+	if (si == NULL) {
+		cmdq_error(item, "%s: failed to parse sixel image", xpath);
+		return (CMD_RETURN_ERROR);
+	}
+
+	image_overlay_set(tc, si, (u_int)x, (u_int)y);
+	return (CMD_RETURN_NORMAL);
+}
