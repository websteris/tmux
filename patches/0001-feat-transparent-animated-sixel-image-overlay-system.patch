diff --git a/image-gif.c b/image-gif.c
new file mode 100644
--- a/image-gif.c
+++ b/image-gif.c
@@ -0,0 +1,230 @@
+/* $OpenBSD$ */
+
+/*
+ * Copyright (c) 2024 Thomas Adam <thomas@xteddy.org>
+ *
+ * Permission to use, copy, modify, and distribute this software for any
+ * purpose with or without fee is hereby granted, provided that the above
+ * copyright notice and this permission notice appear in all copies.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES
+ * WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
+ * MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR
+ * ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+ * WHATSOEVER RESULTING FROM LOSS OF MIND, USE, DATA OR PROFITS, WHETHER
+ * IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING
+ * OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+#ifdef HAVE_GIFLIB
+
+#include <sys/types.h>
+
+#include <stdlib.h>
+#include <string.h>
+
+#include <gif_lib.h>
+
+#include "tmux.h"
+
+/*
+ * Load an animated (or static) GIF and return an array of sixel frames with
+ * per-frame durations in milliseconds.
+ *
+ * pw, ph:  target pixel dimensions; 0 means use the GIF's natural screen size.
+ * xpixel, ypixel: terminal cell pixel size, passed to sixel_parse.
+ *
+ * On success returns nframes > 0 and fills *framesp / *durationsp (both
+ * xcalloc'd; caller frees with sixel_free + free on the arrays).
+ * On error returns 0 and sets *errp to a static error string.
+ */
+
+/* Nearest-neighbor scale of an RGBA buffer from (sw x sh) to (dw x dh). */
+static u_char *
+rgba_scale(const u_char *src, u_int sw, u_int sh, u_int dw, u_int dh)
+{
+	u_char	*dst;
+	u_int	 x, y, sx, sy;
+
+	dst = xmalloc((size_t)dw * dh * 4);
+	for (y = 0; y < dh; y++) {
+		sy = y * sh / dh;
+		for (x = 0; x < dw; x++) {
+			sx = x * sw / dw;
+			memcpy(dst + (y * dw + x) * 4,
+			    src + (sy * sw + sx) * 4, 4);
+		}
+	}
+	return (dst);
+}
+
+/*
+ * Extract delay (centiseconds) and transparent color index from a frame's
+ * Graphic Control Extension block.  Sets defaults when no GCE is present.
+ */
+static void
+gif_gce(const SavedImage *img, int *delay_cs, int *trans_idx, int *disposal)
+{
+	int			 i;
+	const ExtensionBlock	*eb;
+
+	*delay_cs  = 10;	/* default: 100 ms */
+	*trans_idx = -1;
+	*disposal  = 0;
+
+	for (i = 0; i < img->ExtensionBlockCount; i++) {
+		eb = &img->ExtensionBlocks[i];
+		if (eb->Function == GRAPHICS_EXT_FUNC_CODE &&
+		    eb->ByteCount >= 4) {
+			*disposal  = ((unsigned char)eb->Bytes[0] >> 2) & 0x07;
+			*delay_cs  = (unsigned char)eb->Bytes[1] |
+			    ((unsigned char)eb->Bytes[2] << 8);
+			if (*delay_cs <= 0)
+				*delay_cs = 10;
+			if ((unsigned char)eb->Bytes[0] & 0x01)
+				*trans_idx = (unsigned char)eb->Bytes[3];
+			return;
+		}
+	}
+}
+
+/* Return the active color map for this frame (local preferred, else global). */
+static const ColorMapObject *
+gif_cmap(const GifFileType *gif, const SavedImage *img)
+{
+	if (img->ImageDesc.ColorMap != NULL)
+		return (img->ImageDesc.ColorMap);
+	return (gif->SColorMap);
+}
+
+u_int
+image_load_gif(const char *path, u_int pw, u_int ph,
+    u_int xpixel, u_int ypixel,
+    struct sixel_image ***framesp, u_int **durationsp, const char **errp)
+{
+	GifFileType		*gif;
+	int			 gerr;
+	u_int			 nframes, i;
+	struct sixel_image	**frames;
+	u_int			*durations;
+	u_char			*canvas;
+	u_int			 lw, lh;
+	const SavedImage	*img;
+	const ColorMapObject	*cmap;
+	const GifColorType	*colors;
+	int			 delay_cs, trans_idx, disposal;
+	u_int			 fx, fy, fw, fh, x, y;
+	u_char			*scaled;
+	struct sixel_image	*si;
+	GifByteType		 idx;
+	u_char			*cp;
+
+	*errp      = NULL;
+	*framesp   = NULL;
+	*durationsp = NULL;
+
+	gerr = 0;
+	gif  = DGifOpenFileName(path, &gerr);
+	if (gif == NULL) {
+		*errp = GifErrorString(gerr);
+		return (0);
+	}
+	if (DGifSlurp(gif) != GIF_OK) {
+		*errp = GifErrorString(gif->Error);
+		DGifCloseFile(gif, &gerr);
+		return (0);
+	}
+	if (gif->ImageCount <= 0) {
+		*errp = "no frames";
+		DGifCloseFile(gif, &gerr);
+		return (0);
+	}
+
+	lw = (u_int)gif->SWidth;
+	lh = (u_int)gif->SHeight;
+	if (lw == 0 || lh == 0) {
+		*errp = "zero-size GIF";
+		DGifCloseFile(gif, &gerr);
+		return (0);
+	}
+
+	nframes   = (u_int)gif->ImageCount;
+	frames    = xcalloc(nframes, sizeof *frames);
+	durations = xcalloc(nframes, sizeof *durations);
+	canvas    = xcalloc((size_t)lw * lh, 4);	/* RGBA, starts transparent */
+
+	for (i = 0; i < nframes; i++) {
+		img  = &gif->SavedImages[i];
+		cmap = gif_cmap(gif, img);
+
+		gif_gce(img, &delay_cs, &trans_idx, &disposal);
+		durations[i] = (u_int)delay_cs * 10;	/* centiseconds → ms */
+
+		fx = (u_int)img->ImageDesc.Left;
+		fy = (u_int)img->ImageDesc.Top;
+		fw = (u_int)img->ImageDesc.Width;
+		fh = (u_int)img->ImageDesc.Height;
+
+		/* Blit this frame onto the canvas. */
+		if (cmap != NULL) {
+			colors = cmap->Colors;
+			for (y = 0; y < fh && fy + y < lh; y++) {
+				for (x = 0; x < fw && fx + x < lw; x++) {
+					idx = img->RasterBits[y * fw + x];
+					if ((int)idx == trans_idx)
+						continue;	/* keep canvas pixel */
+					if (idx >= (unsigned)cmap->ColorCount)
+						continue;
+					cp    = canvas + ((fy + y) * lw + (fx + x)) * 4;
+					cp[0] = colors[idx].Red;
+					cp[1] = colors[idx].Green;
+					cp[2] = colors[idx].Blue;
+					cp[3] = 255;
+				}
+			}
+		}
+
+		/* Encode the composited canvas (optionally scaled). */
+		if (pw > 0 && ph > 0 && (pw != lw || ph != lh)) {
+			scaled = rgba_scale(canvas, lw, lh, pw, ph);
+			si     = sixel_from_rgba(scaled, pw, ph, xpixel, ypixel);
+			free(scaled);
+		} else
+			si = sixel_from_rgba(canvas, lw, lh, xpixel, ypixel);
+
+		if (si == NULL) {
+			*errp = "sixel encode failed";
+			while (i > 0)
+				sixel_free(frames[--i]);
+			free(frames);
+			free(durations);
+			free(canvas);
+			DGifCloseFile(gif, &gerr);
+			return (0);
+		}
+		frames[i] = si;
+
+		/*
+		 * Apply this frame's disposal method to prepare the canvas for
+		 * the next frame.
+		 *   0, 1 — keep canvas as-is
+		 *   2    — restore frame region to transparent
+		 *   3    — restore to previous (treat as 2 for simplicity)
+		 */
+		if (disposal >= 2) {
+			for (y = 0; y < fh && fy + y < lh; y++) {
+				for (x = 0; x < fw && fx + x < lw; x++) {
+					cp    = canvas + ((fy + y) * lw + (fx + x)) * 4;
+					cp[0] = cp[1] = cp[2] = cp[3] = 0;
+				}
+			}
+		}
+	}
+
+	free(canvas);
+	DGifCloseFile(gif, &gerr);
+
+	*framesp    = frames;
+	*durationsp = durations;
+	return (nframes);
+}
+
+#endif /* HAVE_GIFLIB */
diff --git a/image-overlay.c b/image-overlay.c
new file mode 100644
--- a/image-overlay.c
+++ b/image-overlay.c
@@ -0,0 +1,178 @@
+/* $OpenBSD$ */
+
+/*
+ * Copyright (c) 2024 Thomas Adam <thomas@xteddy.org>
+ *
+ * Permission to use, copy, modify, and distribute this software for any
+ * purpose with or without fee is hereby granted, provided that the above
+ * copyright notice and this permission notice appear in all copies.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES
+ * WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
+ * MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR
+ * ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+ * WHATSOEVER RESULTING FROM LOSS OF MIND, USE, DATA OR PROFITS, WHETHER
+ * IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING
+ * OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+#include <sys/types.h>
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "tmux.h"
+
+struct image_overlay {
+	struct sixel_image	*si;		/* current frame */
+	u_int			 x;
+	u_int			 y;
+	u_int			 sx;
+	u_int			 sy;
+
+	/* Animation (nframes > 0 when animating) */
+	struct sixel_image	**frames;
+	u_int			 *durations;	/* ms per frame */
+	u_int			  nframes;
+	u_int			  frame;
+	struct event		  timer;
+	struct client		 *c;
+};
+
+void
+image_overlay_set(struct client *c, struct sixel_image *si, u_int x, u_int y)
+{
+	struct image_overlay	*io;
+
+	image_overlay_clear(c);
+	io = xcalloc(1, sizeof *io);
+	io->si = si;
+	io->x = x;
+	io->y = y;
+	sixel_size_in_cells(si, &io->sx, &io->sy);
+	c->image_overlay = io;
+	server_redraw_client(c);
+}
+
+void
+image_overlay_clear(struct client *c)
+{
+	struct image_overlay	*io = c->image_overlay;
+	u_int			 i;
+
+	if (io == NULL)
+		return;
+	if (io->nframes > 0) {
+		evtimer_del(&io->timer);
+		for (i = 0; i < io->nframes; i++)
+			sixel_free(io->frames[i]);
+		free(io->frames);
+		free(io->durations);
+	} else {
+		sixel_free(io->si);
+	}
+	free(io);
+	c->image_overlay = NULL;
+}
+
+static void
+image_overlay_timer_cb(__unused int fd, __unused short events, void *data)
+{
+	struct image_overlay	*io = data;
+	struct timeval		 tv;
+
+	io->frame = (io->frame + 1) % io->nframes;
+	io->si = io->frames[io->frame];
+	sixel_size_in_cells(io->si, &io->sx, &io->sy);
+	server_redraw_client(io->c);
+	tv.tv_sec  = io->durations[io->frame] / 1000;
+	tv.tv_usec = (io->durations[io->frame] % 1000) * 1000;
+	evtimer_add(&io->timer, &tv);
+}
+
+void
+image_overlay_animate(struct client *c, struct sixel_image **frames,
+    u_int *durations, u_int nframes, u_int x, u_int y)
+{
+	struct image_overlay	*io;
+	struct timeval		 tv;
+
+	image_overlay_clear(c);
+	io = xcalloc(1, sizeof *io);
+	io->frames = frames;
+	io->durations = durations;
+	io->nframes = nframes;
+	io->frame = 0;
+	io->si = frames[0];
+	io->x = x;
+	io->y = y;
+	sixel_size_in_cells(io->si, &io->sx, &io->sy);
+	io->c = c;
+	tv.tv_sec  = durations[0] / 1000;
+	tv.tv_usec = (durations[0] % 1000) * 1000;
+	evtimer_set(&io->timer, image_overlay_timer_cb, io);
+	evtimer_add(&io->timer, &tv);
+	c->image_overlay = io;
+	server_redraw_client(c);
+}
+
+void
+image_overlay_draw(struct client *c)
+{
+	struct image_overlay	*io = c->image_overlay;
+
+	if (io == NULL)
+		return;
+	tty_draw_overlay_image(&c->tty, io->si, io->x, io->y, io->sx, io->sy);
+}
+
+/*
+ * Remove cells covered by the image overlay from a visible_ranges set for
+ * screen row py.  Called from screen_redraw_draw_pane so that we never send
+ * blank cells over the overlay area, eliminating the clear-then-repaint flash.
+ */
+void
+image_overlay_clip_ranges(struct client *c, struct visible_ranges *r, u_int py)
+{
+	struct image_overlay	*io = c->image_overlay;
+	u_int			 i, n, clip_x, clip_end, rx, rend;
+	struct visible_range	*ri;
+
+	if (io == NULL)
+		return;
+	if (py < io->y || py >= io->y + io->sy)
+		return;
+
+	clip_x   = io->x;
+	clip_end = io->x + io->sx;
+	n = r->used;
+
+	for (i = 0; i < n; i++) {
+		ri   = &r->ranges[i];
+		rx   = ri->px;
+		rend = ri->px + ri->nx;
+
+		if (ri->nx == 0 || rend <= clip_x || rx >= clip_end)
+			continue;
+
+		if (rx >= clip_x && rend <= clip_end) {
+			/* Fully inside overlay: hide. */
+			ri->nx = 0;
+		} else if (rx < clip_x && rend > clip_end) {
+			/* Spans across overlay: split into left + right. */
+			server_client_ensure_ranges(r, r->used + 1);
+			ri = &r->ranges[i];	/* re-read after possible realloc */
+			r->ranges[r->used].px = clip_end;
+			r->ranges[r->used].nx = rend - clip_end;
+			r->used++;
+			ri->nx = clip_x - rx;
+		} else if (rx < clip_x) {
+			/* Overlaps right edge of range: truncate. */
+			ri->nx = clip_x - rx;
+		} else {
+			/* Starts inside overlay, ends outside: shift right. */
+			ri->px = clip_end;
+			ri->nx = rend - clip_end;
+		}
+	}
+}
diff --git a/image-png.c b/image-png.c
new file mode 100644
--- a/image-png.c
+++ b/image-png.c
@@ -0,0 +1,155 @@
+/* $OpenBSD$ */
+
+/*
+ * Copyright (c) 2024 Thomas Adam <thomas@xteddy.org>
+ *
+ * Permission to use, copy, modify, and distribute this software for any
+ * purpose with or without fee is hereby granted, provided that the above
+ * copyright notice and this permission notice appear in all copies.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES
+ * WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
+ * MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR
+ * ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+ * WHATSOEVER RESULTING FROM LOSS OF MIND, USE, DATA OR PROFITS, WHETHER
+ * IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING
+ * OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+#ifdef HAVE_LIBPNG
+
+#include <sys/types.h>
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <png.h>
+
+#include "tmux.h"
+
+/*
+ * Load a PNG file with alpha channel and convert it to a sixel_image.
+ *
+ * pw, ph: target pixel dimensions; 0 means use the image's natural size.
+ * If only one dimension is given (the other is 0), the missing dimension is
+ * computed from the image's aspect ratio.
+ *
+ * Returns NULL on error and sets *errp to a descriptive string.
+ */
+struct sixel_image *
+image_load_png(const char *path, u_int pw, u_int ph,
+    u_int xpixel, u_int ypixel, const char **errp)
+{
+	FILE		   *fp;
+	png_structp	    png;
+	png_infop	    info;
+	u_int		    w, h, y, dx, dy, sx, sy;
+	/* volatile: these are modified after setjmp; must survive longjmp. */
+	volatile u_int	    tw, th;
+	u_char		  **volatile rows = NULL, *volatile rgba = NULL, *scaled;
+	struct sixel_image *si;
+	int		    bit_depth, color_type;
+
+	tw = pw;
+	th = ph;
+
+	*errp = NULL;
+
+	fp = fopen(path, "rb");
+	if (fp == NULL) {
+		*errp = strerror(errno);
+		return (NULL);
+	}
+
+	png = png_create_read_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, NULL);
+	if (png == NULL) {
+		*errp = "png_create_read_struct failed";
+		fclose(fp);
+		return (NULL);
+	}
+
+	info = png_create_info_struct(png);
+	if (info == NULL) {
+		*errp = "png_create_info_struct failed";
+		png_destroy_read_struct(&png, NULL, NULL);
+		fclose(fp);
+		return (NULL);
+	}
+
+	if (setjmp(png_jmpbuf(png))) {
+		*errp = "PNG decode error";
+		free(rows);
+		free(rgba);
+		png_destroy_read_struct(&png, &info, NULL);
+		fclose(fp);
+		return (NULL);
+	}
+
+	png_init_io(png, fp);
+	png_read_info(png, info);
+
+	w          = png_get_image_width(png, info);
+	h          = png_get_image_height(png, info);
+	bit_depth  = png_get_bit_depth(png, info);
+	color_type = png_get_color_type(png, info);
+
+	/* Normalise to RGBA 8-bit. */
+	if (color_type == PNG_COLOR_TYPE_PALETTE)
+		png_set_palette_to_rgb(png);
+	if (color_type == PNG_COLOR_TYPE_GRAY && bit_depth < 8)
+		png_set_expand_gray_1_2_4_to_8(png);
+	if (png_get_valid(png, info, PNG_INFO_tRNS))
+		png_set_tRNS_to_alpha(png);
+	if (bit_depth == 16)
+		png_set_strip_16(png);
+	if (color_type == PNG_COLOR_TYPE_GRAY ||
+	    color_type == PNG_COLOR_TYPE_GRAY_ALPHA)
+		png_set_gray_to_rgb(png);
+	/* Add alpha channel for non-alpha colour types. */
+	if (color_type == PNG_COLOR_TYPE_RGB ||
+	    color_type == PNG_COLOR_TYPE_GRAY ||
+	    color_type == PNG_COLOR_TYPE_PALETTE)
+		png_set_filler(png, 0xff, PNG_FILLER_AFTER);
+
+	png_read_update_info(png, info);
+
+	rgba = xmalloc((size_t)w * h * 4);
+	rows = xmalloc(h * sizeof *rows);
+	for (y = 0; y < h; y++)
+		rows[y] = rgba + (size_t)y * w * 4;
+
+	png_read_image(png, (png_bytepp)rows);
+	png_read_end(png, NULL);
+	png_destroy_read_struct(&png, &info, NULL);
+	fclose(fp);
+	free(rows);
+
+	/* Resolve a partial target size from the image's aspect ratio. */
+	if (tw == 0 && th > 0 && h > 0)
+		tw = th * w / h;
+	else if (th == 0 && tw > 0 && w > 0)
+		th = tw * h / w;
+
+	if (tw > 0 && th > 0 && (tw != w || th != h)) {
+		scaled = xmalloc((size_t)tw * th * 4);
+		for (dy = 0; dy < th; dy++) {
+			sy = dy * h / th;
+			for (dx = 0; dx < tw; dx++) {
+				sx = dx * w / tw;
+				memcpy(scaled + (dy * tw + dx) * 4,
+				    rgba + (sy * w + sx) * 4, 4);
+			}
+		}
+		free(rgba);
+		si = sixel_from_rgba(scaled, tw, th, xpixel, ypixel);
+		free(scaled);
+	} else {
+		si = sixel_from_rgba(rgba, w, h, xpixel, ypixel);
+		free(rgba);
+	}
+
+	if (si == NULL)
+		*errp = "sixel encode failed";
+	return (si);
+}
+
+#endif /* HAVE_LIBPNG */
